# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# REQUIRED — the Node server refuses to start without these two.

# College Football Data API key. Free: https://collegefootballdata.com/key
CFB_API_KEY=your_collegefootballdata_api_key

# Secret used to sign session cookies. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace_with_a_long_random_string

# ---------------------------------------------------------------------------
# OPTIONAL — everything below has a working fallback.
# ---------------------------------------------------------------------------

# Auth0, for real email 2FA on the login page. See AUTH0_SETUP.md.
# Leave blank to run in dev mode, where any 6-digit code is accepted.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret

# Python data pipeline (scripts/). Same CFBD key as above.
CFBD_API_KEY=your_collegefootballdata_api_key

# Cerebras API key, for the AI coach chatbot. Blank = chatbot falls back to
# a non-LLM response. https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Vector store. USE_CHROMADB=1 uses the local ChromaDB at the path below.
USE_CHROMADB=1
CHROMA_PERSIST_DIRECTORY=./chroma_backup

# Port for the Express server (default 8080).
PORT=8080
